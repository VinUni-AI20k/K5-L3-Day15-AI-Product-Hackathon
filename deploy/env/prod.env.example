# /srv/vpost/.env — VPOST production environment template.
#
# Copy to $VPS_APP_DIR/.env on the VPS, fill in every required value, and lock
# permissions (`chmod 600 /srv/vpost/.env`). NEVER commit a real `.env` file.
#
# Variables wired automatically by deploy/docker-compose.prod.yml (do NOT override
# with localhost addresses):
#   NODE_ENV=production
#   LOG_PRETTY=false
#   PORT=8021 (api)
#   DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
#   REDIS_URL=redis://redis:6379
#   VPOST_API_URL=http://api:8021
#   UPLOAD_STORAGE_ROOT=/var/lib/vpost/uploads
#   CATALOG_STORAGE_ROOT=/var/lib/vpost/catalog
#   MEDIA_CACHE_ROOT=/var/lib/vpost/media-cache
#   WORKER_HEARTBEAT_FILE=/tmp/vpost-worker-heartbeat
#   IMAGE_PREFIX / IMAGE_TAG (written by CI to .image-tag.env on every deploy)

# =============================================================================
# 1. Datastores (REQUIRED — compose derives DATABASE_URL from these)
# =============================================================================
POSTGRES_USER=vpost
# REQUIRED. Generate with `openssl rand -hex 24` (hex, NOT base64: "/" or "+"
# inside a password breaks DATABASE_URL parsing).
POSTGRES_PASSWORD=
POSTGRES_DB=vpost

# =============================================================================
# 2. Runtime & Logging
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# 3. Operator Sign-in & Session (Next.js Auth.js)
# =============================================================================
# REQUIRED. Public HTTPS origin used for OAuth callbacks and invite links.
AUTH_URL=https://vpost.vannt.asia
# REQUIRED. At least 32 chars. Generate with `openssl rand -base64 48`.
# Changing this invalidates all existing operator sessions.
SESSION_SECRET=
# Google OAuth 2.0 Web Client (Authorized redirect URI:
# https://vpost.vannt.asia/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated email domains allowed to attempt Google sign-in (filter only,
# never grants admin). Blank = no domain filter; new accounts still require approval.
AUTH_ALLOWED_DOMAINS=
# Comma-separated exact bootstrap admin emails (escape hatch — set at least one
# before first deploy so someone can approve operators).
AUTH_BOOTSTRAP_ADMINS=
# Comma-separated exact Facebook user IDs granted bootstrap admin rights.
AUTH_FACEBOOK_ALLOWED_USER_IDS=

# =============================================================================
# 4. Python Backend — AI Model (codebase/ai.py)
# =============================================================================
# MODEL_PROVIDER: openai (production) | fake (dry-run without external calls).
MODEL_PROVIDER=openai
# Model ID supported by MODEL_PROVIDER (e.g. gpt-4.1-mini, gpt-5.4-mini).
MODEL_NAME=gpt-4.1-mini
# Provider API key for MODEL_PROVIDER. Keep secret.
API_KEY=

# =============================================================================
# 5. Python Backend — Facebook & Shop Settings (codebase/server.py, vpost_api.py)
# =============================================================================
# Optional fallback test Fanpage credentials (leave blank if connecting Pages
# via OAuth in the Channels screen).
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_PAGE_NAME=
# Facebook App credentials for connecting Pages in the Channels screen.
FB_APP_ID=
FB_APP_SECRET=
FB_USER_TOKEN=
# Must match a Valid OAuth Redirect URI configured in the Meta App dashboard.
FB_OAUTH_REDIRECT_URI=https://vpost.vannt.asia/api/channels/callback
# Optional Facebook Login for Business Configuration ID (replaces scope when set).
FB_LOGIN_CONFIG_ID=
FB_GRAPH_VERSION=v23.0
# Public UI origin used after Facebook OAuth callback redirect.
VPOST_UI_URL=https://vpost.vannt.asia
# Tenant UUID served by the Python backend. Blank = auto-detect from public.tenant
# when exactly 1 active tenant exists; set explicitly in multi-tenant setups.
VPOST_TENANT_ID=
# PostgreSQL schema for Python backend shop tables (isolated from Next's `public`).
VPOST_DB_SCHEMA=shop
# Comment sync polling interval in seconds (default 60; 0 disables polling).
VPOST_COMMENT_SYNC_SECONDS=60
# Maximum AI comment reply drafts generated per sync tick (default 10).
VPOST_AUTO_DRAFT_MAX_PER_TICK=10
# Set to 1 to globally disable auto-reply (emergency kill switch). Blank/0 = normal.
VPOST_AUTO_REPLY_DISABLED=0
# Set to 1 to expose 5 demo pages from data/pages.json. Keep 0 in production.
VPOST_DEMO_PAGES=0

# =============================================================================
# 6. Next.js — Facebook / Meta OAuth & Graph API (optional/on-demand)
# =============================================================================
META_GRAPH_VERSION=v23.0
# Setting META_APP_ID + META_APP_SECRET enables "Sign in with Facebook" in NextAuth.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://vpost.vannt.asia/api/channels/callback

# =============================================================================
# 7. Next.js — Google Drive / Sheets (optional/on-demand)
# =============================================================================
# Entire service account JSON on a single line, wrapped in single quotes.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Must also be listed as an Authorized redirect URI on the Google OAuth client above.
GOOGLE_OAUTH_REDIRECT_URI=https://vpost.vannt.asia/api/catalog/google/callback

# =============================================================================
# 8. Next.js — AI Gateway (optional/on-demand; VPOST captions use Python `api`)
# =============================================================================
OPENAI_API_KEY=
# Google AI Studio key (paid tier only; blank = disabled).
GOOGLE_AI_API_KEY=

# =============================================================================
# 9. Next.js — Media Signing & Tenant Secret Sealing (optional/on-demand)
# =============================================================================
# Base64 of exactly 32 bytes: `openssl rand -base64 32`.
TENANT_SECRETS_ENC_KEY=
# At least 32 chars: `openssl rand -base64 48`.
MEDIA_SIGNING_SECRET=
MEDIA_PUBLIC_BASE_URL=https://vpost.vannt.asia

# =============================================================================
# 10. Next.js — Worker, Reaper & Cache Knobs
# =============================================================================
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_SHUTDOWN_DEADLINE_MS=30000
WORKER_REAPER_INTERVAL_MS=300000
WORKER_PUBLISHING_STALE_MS=900000
WORKER_OVERDUE_QUEUED_MS=600000
WORKER_REAPER_LIMIT=50
UPLOAD_ORPHAN_TTL_HOURS=24
MEDIA_CACHE_TTL_HOURS=72

# =============================================================================
# 11. Next.js — MinIO Object Storage (optional external MinIO)
# =============================================================================
# Not started in this 6-service stack (uploads go through Python `api`).
# Leave MINIO_ACCESS_KEY / MINIO_SECRET_KEY blank unless pointing at an external
# MinIO instance; compose supplies safe non-empty placeholders so `web` and
# `worker` boot cleanly.
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://media.vannt.asia
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=vpost-media
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
