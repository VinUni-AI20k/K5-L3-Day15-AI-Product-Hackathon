# Chép file này thành .env rồi điền (Windows: copy .env.example .env · macOS/Linux: cp .env.example .env).
# KHÔNG commit .env (đã có trong .gitignore). Không dán key vào code, slide, ảnh chụp màn hình.
# BTC KHÔNG cấp API key: dùng gói miễn phí hoặc tài khoản của nhóm (xem docs/connect-model.md).
# MODEL_PROVIDER: để trống hoặc fake = chế độ giả (chưa gọi model) · gemini / openai / anthropic / ollama …
# MODEL_NAME: mã gọi API của model, đúng như tài liệu nhà cung cấp.
MODEL_PROVIDER=
MODEL_NAME=
API_KEY=
# Lên lịch thật lên Fanpage THỬ của nhóm (bỏ trống = chỉ lịch trong app). Không commit token.
FB_PAGE_ID=
FB_PAGE_TOKEN=
# App Facebook: OAuth ở màn Kênh (nối Page) và scripts/fb_token.py. Không commit secret.
FB_APP_ID=
FB_APP_SECRET=
FB_USER_TOKEN=
# Tuỳ chọn. Redirect mặc định http://localhost:3010/api/channels/callback (phải khai trong app Facebook).
FB_OAUTH_REDIRECT_URI=
# Tuỳ chọn: app dùng "Facebook Login for Business" thì điền Configuration ID thay cho scope.
FB_LOGIN_CONFIG_ID=
